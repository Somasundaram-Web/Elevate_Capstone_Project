# Copy this file to ".env" and fill in your token, then restart "npm start".
#
# A GitHub Personal Access Token raises the API limit from 60 to 5,000 requests/hour
# (and the search limit from 10 to 30 requests/minute).
# Create one at: https://github.com/settings/tokens
# No scopes are needed for public repositories (a fine-grained token with
# "Public Repositories (read-only)" access is enough).
#
# NOTE: Create React App embeds REACT_APP_* variables in the browser bundle.
# Use a read-only token and never deploy a privileged token publicly.
REACT_APP_GITHUB_TOKEN= GITHUB_TOKEN=your_github_token_here
